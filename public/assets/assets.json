{
  "schemaVersion": 1,
  "readme": "Sprite and background manifest for Cosmic Chaos. Sizes, byte counts and sha256 are written only by `npm run assets:lock` (human only). Agents may tune renderScale, anchor, keyframes, arena and viewport. Image files are read-only. All 'file' values are relative to this directory. Logical arena space is the canvas-03 native pixel grid, 1408x768, so world coordinates and image pixels line up 1:1.",
  "conventions": {
    "facing": "Sprites face right unless the entry says otherwise. Flip with scaleX = -1 to face left; never edit the image.",
    "pixelArt": "Draw with imageSmoothingEnabled = false and image-rendering: pixelated.",
    "anchor": "Normalized within the sprite box. {x: 0.5, y: 1} is bottom center and suits grounded sprites; flyers and swimmers use a centered anchor.",
    "renderScale": "Multiplier from native pixels to arena pixels. Shark is authored about 6x larger than the cast, so its renderScale is much smaller.",
    "keyframes": "t runs 0 to 1 inclusive, must not decrease. dx, dy are arena pixels, rot is radians, sx and sy scale the sprite, alpha is 0 to 1.",
    "aliases": "Points an animation name at another defined animation, for poses that have no art of their own."
  },
